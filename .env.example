# Required in production: the admin password used to sign in at /admin.
# In development you can instead create a password on the /admin/login page.
# Once a password is changed from the dashboard, the saved one takes over.
ADMIN_PASSWORD=

# Login ID for /admin. Defaults to "admin" if empty.
ADMIN_USERNAME=

# Optional: secret used to sign admin sessions. Generated into data/auth.json if empty.
SESSION_SECRET=

# Optional: where content.json, submissions.json and uploads/ are stored. Defaults to ./data
DATA_DIR=

# Set to "false" only if the production site is served over plain http (not recommended).
COOKIE_SECURE=

# --- Hosted storage (set automatically when you add a Blob store in Vercel → Storage) ---
# Vercel Blob (public store): images, plus content, inbox and login files
BLOB_READ_WRITE_TOKEN=
