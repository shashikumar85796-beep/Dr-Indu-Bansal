# --- Dashboard logins (/admin) ---
# Owner: full control (settings, Sangh pages, page sections, backups, editor login).
# The ID defaults to "owner" if SUPERADMIN_USERNAME is empty.
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

# Editor: daily content only (news, press coverage, photos, videos, achievements, partner logos, inbox).
# The ID defaults to "admin" if ADMIN_USERNAME is empty.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Logins changed from Admin → Account replace these values.
# In development you can also create the first owner login on the /admin/login page.

# Optional: secret used to sign admin sessions. Generated and stored if empty.
SESSION_SECRET=

# Optional: where content.json, submissions.json and uploads/ are stored. Defaults to ./data
DATA_DIR=

# Set to "false" only if the production site is served over plain http (not recommended).
COOKIE_SECURE=

# --- Hosted storage (set automatically when you add a Blob store in Vercel → Storage) ---
# Vercel Blob (public store): images, plus content, inbox and login files
BLOB_READ_WRITE_TOKEN=
